{
  "name": "@zod2go/export",
  "version": "0.1.0",
  "description": "Export Zod v4 schemas to the zod2go IR format for Go validation",
  "license": "MIT",
  "type": "module",
  "bin": {
    "zod2go-export": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.19.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "!dist/*.test.js",
    "!dist/*.test.d.ts"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
